{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "SIU Hotel — Staff & Guest/Public API",
    "description": "Staff APIs (dashboard/CMS, RBAC, rooms, bookings with createdBy) and Guest/Public APIs (website rooms + hero, app registration). MinIO: form-data File uploads. Variables: room_type_id, room_id, customer_id, staff_id, booking_id, role_staff_id (default seed_role_staff from migration). Seed: npm run db:seed — reception@siu-hotel.local / StaffDemo123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "room_type_id", "value": "REPLACE_WITH_ROOM_TYPE_CUID" },
    { "key": "room_id", "value": "REPLACE_WITH_ROOM_CUID" },
    { "key": "customer_id", "value": "REPLACE_WITH_CUSTOMER_CUID" },
    { "key": "staff_id", "value": "REPLACE_WITH_STAFF_USER_CUID" },
    { "key": "role_staff_id", "value": "seed_role_staff" },
    { "key": "booking_id", "value": "REPLACE_WITH_BOOKING_CUID" }
  ],
  "item": [
    {
      "name": "Staff APIs",
      "description": "Management dashboard & POS: RBAC, users, rooms, walk-in customers, bookings (createdBy), payments, CMS (hero + hotel info).",
      "item": [
        {
          "name": "Health",
          "item": [
            {
              "name": "Health check",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/health",
                "description": "Confirms the API process is running."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Role",
          "item": [
            {
              "name": "List roles with permissions",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/roles",
                "description": "RBAC roles (STAFF, ADMIN) and permission codes. Use role id from GET /roles for POST /users.roleId."
              },
              "response": []
            }
          ]
        },
        {
          "name": "User",
          "item": [
            {
              "name": "Create staff user",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"frontdesk@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"fullName\": \"Front Desk\",\n  \"roleId\": \"{{role_staff_id}}\"\n}"
                },
                "url": "{{baseUrl}}/users",
                "description": "201 — set `staff_id` from `data.id` for booking.createdBy. Optional roleId (defaults to STAFF role from DB)."
              },
              "response": []
            },
            {
              "name": "List staff users",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/users",
                "description": "Returns staff with role and permission codes (no password hashes)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "RoomType",
          "item": [
            {
              "name": "Create room type",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Deluxe King\",\n  \"basePrice\": 189.5,\n  \"description\": \"King bed, city view\",\n  \"images\": []\n}"
                },
                "url": "{{baseUrl}}/room-types",
                "description": "201 — copy returned `data.id` into collection variable `room_type_id` for dependent requests."
              },
              "response": []
            },
            {
              "name": "List all room types",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/room-types",
                "description": "Use `data[].id` to fill `room_type_id`."
              },
              "response": []
            },
            {
              "name": "Get room type by id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/room-types/{{room_type_id}}",
                "description": "404 if id is invalid."
              },
              "response": []
            },
            {
              "name": "Update room type",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Deluxe King Suite\",\n  \"basePrice\": 219.99\n}"
                },
                "url": "{{baseUrl}}/room-types/{{room_type_id}}",
                "description": "At least one of name, basePrice, description (null clears description)."
              },
              "response": []
            },
            {
              "name": "Upload room-type image (form-data)",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "description": "JPEG, PNG, WebP, or GIF. Stored in MinIO bucket hotel-pos-assets.",
                      "type": "file",
                      "src": ""
                    }
                  ]
                },
                "url": "{{baseUrl}}/room-types/{{room_type_id}}/images",
                "description": "form-data: add multiple File rows (same key `file` or different keys). All parts are uploaded; response data.objectPaths lists each MinIO key."
              },
              "response": []
            },
            {
              "name": "Delete room-type image",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"objectPath\": \"room-types/{{room_type_id}}/YOUR_OBJECT_KEY_FROM_UPLOAD_RESPONSE\"\n}"
                },
                "url": "{{baseUrl}}/room-types/{{room_type_id}}/images",
                "description": "Replace YOUR_OBJECT_KEY... with the full `objectPath` from upload success `data`."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Room",
          "item": [
            {
              "name": "Create room",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"roomNumber\": \"301\",\n  \"roomTypeId\": \"{{room_type_id}}\",\n  \"status\": \"AVAILABLE\"\n}"
                },
                "url": "{{baseUrl}}/rooms",
                "description": "Requires a valid `room_type_id`. After success, set collection variable `room_id` from `data.id`."
              },
              "response": []
            },
            {
              "name": "List all rooms (no filters)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/rooms",
                "description": "GET /rooms with no query — returns every room with nested roomType."
              },
              "response": []
            },
            {
              "name": "List rooms (filter by status & type)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/rooms?status=AVAILABLE&roomTypeId={{room_type_id}}",
                "description": "Optional query: status only, roomTypeId only, or both. Remove params you do not need."
              },
              "response": []
            },
            {
              "name": "Get room by id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/rooms/{{room_id}}",
                "description": "404 if id invalid."
              },
              "response": []
            },
            {
              "name": "Update room status",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"OCCUPIED\"\n}"
                },
                "url": "{{baseUrl}}/rooms/{{room_id}}",
                "description": "Status: AVAILABLE | OCCUPIED | MAINTENANCE. PUT also accepts roomNumber and/or roomTypeId."
              },
              "response": []
            },
            {
              "name": "Upload room image (form-data)",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "description": "JPEG, PNG, WebP, or GIF. Stored in MinIO bucket hotel-pos-assets under rooms/{{room_id}}/...",
                      "type": "file",
                      "src": ""
                    }
                  ]
                },
                "url": "{{baseUrl}}/rooms/{{room_id}}/images",
                "description": "form-data: multiple File rows allowed. Response data.objectPaths has every new object key; DB images[] updated once."
              },
              "response": []
            },
            {
              "name": "Delete room image",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"objectPath\": \"rooms/{{room_id}}/YOUR_OBJECT_KEY_FROM_UPLOAD_RESPONSE\"\n}"
                },
                "url": "{{baseUrl}}/rooms/{{room_id}}/images",
                "description": "Use full `objectPath` from upload `data`."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Customer (walk-in)",
          "item": [
            {
              "name": "Create walk-in customer",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Amina Hassan\",\n  \"phoneNumber\": \"+252612345678\"\n}"
                },
                "url": "{{baseUrl}}/customers",
                "description": "Staff POS: only fullName + phoneNumber. 201 — set `customer_id` from `data.id`."
              },
              "response": []
            },
            {
              "name": "List customers",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/customers",
                "description": "Returns customers without password hashes."
              },
              "response": []
            },
            {
              "name": "Get customer by id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/customers/{{customer_id}}",
                "description": "404 if id invalid."
              },
              "response": []
            },
            {
              "name": "Update customer",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Amina H.\"\n}"
                },
                "url": "{{baseUrl}}/customers/{{customer_id}}",
                "description": "Partial update. Optional email (null clears), password (min 8), idCard/address (null clears)."
              },
              "response": []
            },
            {
              "name": "Delete customer",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/customers/{{customer_id}}",
                "description": "200 — data.deleted true"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Booking",
          "item": [
            {
              "name": "Check-in / create booking",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"roomId\": \"{{room_id}}\",\n  \"createdBy\": \"{{staff_id}}\",\n  \"checkIn\": \"2026-06-01T14:00:00.000Z\",\n  \"checkOut\": \"2026-06-04T11:00:00.000Z\"\n}"
                },
                "url": "{{baseUrl}}/bookings",
                "description": "Check-in: room becomes OCCUPIED. Optional createdBy = staff user id (walk-in handler). Legacy staffId in JSON is still accepted. Sets booking_id from data.id."
              },
              "response": []
            },
            {
              "name": "List bookings",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/bookings",
                "description": "Includes customer, room, and createdBy staff (if set)."
              },
              "response": []
            },
            {
              "name": "Get booking by id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/bookings/{{booking_id}}",
                "description": "404 if unknown id."
              },
              "response": []
            },
            {
              "name": "Check out (POST)",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/bookings/{{booking_id}}/checkout",
                "description": "Sets booking status COMPLETED and room AVAILABLE."
              },
              "response": []
            },
            {
              "name": "Check out (PUT)",
              "request": {
                "method": "PUT",
                "header": [],
                "url": "{{baseUrl}}/bookings/{{booking_id}}/check-out",
                "description": "Check-out: booking COMPLETED, room AVAILABLE (same as POST /checkout)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Transaction",
          "item": [
            {
              "name": "Create payment (transaction)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"bookingId\": \"{{booking_id}}\",\n  \"amount\": 199.99,\n  \"paymentMethod\": \"CASH\"\n}"
                },
                "url": "{{baseUrl}}/transactions",
                "description": "paymentMethod: CASH | EVC_PLUS | PREMIER_BANK | SAHAL"
              },
              "response": []
            },
            {
              "name": "List transactions",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/transactions",
                "description": "All payment rows."
              },
              "response": []
            },
            {
              "name": "Get transaction by id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/transactions/REPLACE_TRANSACTION_ID",
                "description": "Replace with id from list/create response."
              },
              "response": []
            },
            {
              "name": "Update transaction",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"REFUNDED\"\n}"
                },
                "url": "{{baseUrl}}/transactions/REPLACE_TRANSACTION_ID",
                "description": "Partial update."
              },
              "response": []
            },
            {
              "name": "Delete transaction",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/transactions/REPLACE_TRANSACTION_ID",
                "description": "200 — deleted true"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Dashboard",
          "item": [
            {
              "name": "GET stats",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/stats",
                "description": "totalRooms, availableRooms, totalCustomers, totalRevenueToday (UTC day, COMPLETED transactions)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "CMS",
          "item": [
            {
              "name": "List hero sections (admin)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/hero-sections",
                "description": "All slides for dashboard editing."
              },
              "response": []
            },
            {
              "name": "Create hero section",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"imageUrl\": \"https://example.com/slide1.jpg\",\n  \"title\": \"Welcome\",\n  \"subTitle\": \"Book your stay\",\n  \"isActive\": true,\n  \"order\": 0\n}"
                },
                "url": "{{baseUrl}}/hero-sections",
                "description": "201 — appears on GET /public/hero when isActive true."
              },
              "response": []
            },
            {
              "name": "Get hotel info",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/hotel-info",
                "description": "Singleton hotel profile for dashboard / website."
              },
              "response": []
            },
            {
              "name": "Update hotel info",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"SIU Hotel\",\n  \"address\": \"123 Main Street\",\n  \"phone\": \"+252000000000\",\n  \"email\": \"info@siu-hotel.local\",\n  \"aboutUs\": \"Welcome to SIU Hotel.\",\n  \"logoUrl\": \"\"\n}"
                },
                "url": "{{baseUrl}}/hotel-info",
                "description": "Upserts singleton hotel_info row."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Guest/Public APIs",
      "description": "Booking website & mobile app: no staff auth required.",
      "item": [
        {
          "name": "Public",
          "item": [
            {
              "name": "List available rooms (website)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/public/rooms",
                "description": "Only AVAILABLE rooms with room type for guest booking UI. Optional query ?roomTypeId="
              },
              "response": []
            },
            {
              "name": "List active hero slides (website)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/public/hero",
                "description": "Active slider items ordered by order field."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Register (app)",
          "item": [
            {
              "name": "Register customer (email + password required)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Yusuf Ali\",\n  \"phoneNumber\": \"+252700000001\",\n  \"email\": \"yusuf.app@example.com\",\n  \"password\": \"AppUser123!\"\n}"
                },
                "url": "{{baseUrl}}/customers/register",
                "description": "201 — app account with hashed password; response never includes password. Use a unique phone and email."
              },
              "response": []
            }
          ]
        }
      ]
    }
  ]
}
