# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Staff dashboard JWT (POST /auth/login, protected POST /room-types & POST /rooms). Min 16 chars; required in production.
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL (Prisma) — REQUIRED. Copy to .env and replace YOUR_NEON_PASSWORD with your Neon password (never commit real passwords in .env.example).
# Neon (this project): database `hotel`, pooler host below. Local dev alternative: postgresql://USER:PASSWORD@localhost:5432/siu_hotel?schema=public
DATABASE_URL="postgresql://neondb_owner:npg_oUi1qfPbZ2Bv@ep-royal-surf-ammw2uys-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# MinIO (S3-compatible) — must be running and reachable for image uploads (otherwise 503 STORAGE_UNAVAILABLE).
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Default bucket; room images always use `hotel-pos-assets` in code.
MINIO_BUCKET=hotel-pos-assets
MINIO_PRESIGNED_EXPIRY_SECONDS=3600
# Region for MinIO makeBucket (defaults to us-east-1 in code if unset)
MINIO_REGION=us-east-1
